# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://fitzy:fitzy@localhost:5432/fitzy
APP_ENV=local
# Single-user auth (M0): set a long random value locally; in GCP it comes from Secret Manager
AUTH_SECRET=change-me
OWNER_EMAIL=you@example.com
# Login password hash: python3 backend/app/security/passwords.py (leave empty to disable login locally)
OWNER_PASSWORD_HASH=
