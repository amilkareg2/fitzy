# One-time bootstrap for Fitzy. Run by a project owner from Cloud Shell.
#
# Creates everything CI needs before it can run infra/main itself:
#   - APIs, the Terraform state bucket
#   - the service accounts (deployer for CI, runtime for Cloud Run)
#   - the Artifact Registry repository CI pushes images to
#   - the Secret Manager secrets fitzy-database-url and fitzy-auth-secret (no values)
#   - Workload Identity Federation for GitHub Actions (no JSON keys anywhere)
#
# The database is Neon serverless Postgres, created by hand in the Neon console; there
# is no Neon provider or API key anywhere. See README.md for the order of operations.
#
# The runtime service account, the Artifact Registry repository and the secrets live
# here, not in infra/main, on purpose: creating them (and their IAM) from CI would
# require project-wide iam.serviceAccountAdmin / artifactregistry.admin /
# secretmanager.admin / projectIamAdmin on the deployer, which would let CI escalate to
# any identity or secret in the project. Keeping them here means the deployer only gets
# narrowly scoped roles on resources that already exist.

data "google_project" "this" {
  project_id = var.project_id
}

locals {
  apis = [
    "artifactregistry.googleapis.com",
    "cloudresourcemanager.googleapis.com",
    "iam.googleapis.com",
    "iamcredentials.googleapis.com",
    "run.googleapis.com",
    "secretmanager.googleapis.com",
    "serviceusage.googleapis.com",
    "storage.googleapis.com",
    "sts.googleapis.com",
    # Not enabled on purpose: sqladmin (the database is Neon, outside GCP) and compute
    # (not needed by Cloud Run; enabling it also creates the default compute service
    # account with the Editor role). Disabling an API that was enabled earlier is left
    # to you (disable_on_destroy = false): `gcloud services disable sqladmin.googleapis.com`.
  ]

  runtime_sa_id  = "fitzy-runtime"
  deployer_sa_id = "fitzy-deployer"
}

resource "google_project_service" "apis" {
  for_each = toset(local.apis)

  project = var.project_id
  service = each.value

  # Other things in this project may use these APIs; never switch them off on destroy.
  disable_on_destroy = false
}

# ---------------------------------------------------------------------------
# Terraform state bucket for infra/main (and optionally for this stack)
# ---------------------------------------------------------------------------

resource "google_storage_bucket" "tfstate" {
  name     = "${var.project_id}-fitzy-tfstate"
  project  = var.project_id
  location = upper(var.region)

  uniform_bucket_level_access = true
  public_access_prevention    = "enforced"
  force_destroy               = false

  versioning {
    enabled = true
  }

  # Keep old state versions for recovery, but not forever.
  lifecycle_rule {
    condition {
      num_newer_versions         = 20
      days_since_noncurrent_time = 30
    }
    action {
      type = "Delete"
    }
  }

  depends_on = [google_project_service.apis]
}

# ---------------------------------------------------------------------------
# Service accounts
# ---------------------------------------------------------------------------

resource "google_service_account" "runtime" {
  project      = var.project_id
  account_id   = local.runtime_sa_id
  display_name = "Fitzy runtime (Cloud Run API + migration job)"

  depends_on = [google_project_service.apis]
}

resource "google_service_account" "deployer" {
  project      = var.project_id
  account_id   = local.deployer_sa_id
  display_name = "Fitzy deployer (GitHub Actions via WIF)"

  depends_on = [google_project_service.apis]
}

# The runtime SA has no project-level roles at all: the database is Neon (reached over
# the internet with credentials from the connection string), and secret access is
# granted per secret below.

# ---------------------------------------------------------------------------
# Secret Manager: both app secrets are created here, with all their IAM.
#
# Why here and not in infra/main: if CI created secrets and their IAM bindings, the
# deployer would need project-wide roles/secretmanager.admin, which in this shared
# project would let CI read and rebind every secret. With the containers and bindings
# owned by bootstrap, the deployer only gets narrow roles on these two secrets:
#   - fitzy-database-url: viewer (version metadata, never the payload). The value is
#     added by the owner by hand (README step 3); CI only pins its version number.
#   - fitzy-auth-secret: the value is still generated by infra/main (random_password),
#     so the deployer can add/manage versions of this one secret and read it back
#     (the provider re-reads secret_data on refresh).
# ---------------------------------------------------------------------------

locals {
  secrets = {
    database_url = "fitzy-database-url"
    auth_secret  = "fitzy-auth-secret"
  }

  deployer_secret_roles = {
    "database_url/viewer"        = { secret = "database_url", role = "roles/secretmanager.viewer" }
    "auth_secret/viewer"         = { secret = "auth_secret", role = "roles/secretmanager.viewer" }
    "auth_secret/versionmanager" = { secret = "auth_secret", role = "roles/secretmanager.secretVersionManager" }
    "auth_secret/accessor"       = { secret = "auth_secret", role = "roles/secretmanager.secretAccessor" }
  }
}

resource "google_secret_manager_secret" "app" {
  for_each = local.secrets

  project   = var.project_id
  secret_id = each.value

  # Single EU region: data stays in the EU and only one replica is billed.
  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }

  depends_on = [google_project_service.apis]
}

# The runtime SA (Cloud Run service + migration job) reads exactly these two secrets.
resource "google_secret_manager_secret_iam_member" "runtime_access" {
  for_each = local.secrets

  project   = var.project_id
  secret_id = google_secret_manager_secret.app[each.key].secret_id
  role      = "roles/secretmanager.secretAccessor"
  member    = google_service_account.runtime.member
}

resource "google_secret_manager_secret_iam_member" "deployer" {
  for_each = local.deployer_secret_roles

  project   = var.project_id
  secret_id = google_secret_manager_secret.app[each.value.secret].secret_id
  role      = each.value.role
  member    = google_service_account.deployer.member
}

# ---------------------------------------------------------------------------
# Deployer roles (least privilege for infra/main + deploys)
# ---------------------------------------------------------------------------

locals {
  deployer_project_roles = {
    # Create/update the Cloud Run service and migration job, execute the job, and set
    # the service's IAM policy (allUsers -> run.invoker). run.developer cannot set IAM.
    # Cloud Run has no narrower role that can do all of this.
    run_admin = "roles/run.admin"

    # Allows API calls that are attributed/billed to this project (quota project), as
    # gcloud and the Terraform provider do. Read-only otherwise.
    serviceusage_consumer = "roles/serviceusage.serviceUsageConsumer"
  }
}

resource "google_project_iam_member" "deployer" {
  for_each = local.deployer_project_roles

  project = var.project_id
  role    = each.value
  member  = google_service_account.deployer.member
}

# Cloud Run service and job run as fitzy-runtime; deploying them requires actAs on that
# one service account only (not on every SA in the project).
resource "google_service_account_iam_member" "deployer_acts_as_runtime" {
  service_account_id = google_service_account.runtime.name
  role               = "roles/iam.serviceAccountUser"
  member             = google_service_account.deployer.member
}

# Read/write/lock Terraform state, on the state bucket only.
resource "google_storage_bucket_iam_member" "deployer_tfstate" {
  bucket = google_storage_bucket.tfstate.name
  role   = "roles/storage.objectAdmin"
  member = google_service_account.deployer.member
}

# Push images, on the fitzy repository only.
resource "google_artifact_registry_repository_iam_member" "deployer_writer" {
  project    = var.project_id
  location   = google_artifact_registry_repository.fitzy.location
  repository = google_artifact_registry_repository.fitzy.name
  role       = "roles/artifactregistry.writer"
  member     = google_service_account.deployer.member
}

# ---------------------------------------------------------------------------
# Artifact Registry
# ---------------------------------------------------------------------------

resource "google_artifact_registry_repository" "fitzy" {
  project       = var.project_id
  location      = var.region
  repository_id = "fitzy"
  format        = "DOCKER"
  description   = "Fitzy container images"

  # Storage is billed beyond the free tier; keep only recent images.
  cleanup_policy_dry_run = false

  cleanup_policies {
    id     = "delete-older-than-30d"
    action = "DELETE"
    condition {
      tag_state  = "ANY"
      older_than = "2592000s"
    }
  }

  cleanup_policies {
    id     = "keep-10-most-recent"
    action = "KEEP"
    most_recent_versions {
      keep_count = 10
    }
  }

  depends_on = [google_project_service.apis]
}

# ---------------------------------------------------------------------------
# Workload Identity Federation for GitHub Actions
# ---------------------------------------------------------------------------

resource "google_iam_workload_identity_pool" "github" {
  project                   = var.project_id
  workload_identity_pool_id = "fitzy-github"
  display_name              = "Fitzy GitHub Actions"
  description               = "OIDC tokens from GitHub Actions for ${var.github_repository}"

  depends_on = [google_project_service.apis]
}

resource "google_iam_workload_identity_pool_provider" "github" {
  project                            = var.project_id
  workload_identity_pool_id          = google_iam_workload_identity_pool.github.workload_identity_pool_id
  workload_identity_pool_provider_id = "github-oidc"
  display_name                       = "GitHub OIDC"

  attribute_mapping = {
    "google.subject"             = "assertion.sub"
    "attribute.repository"       = "assertion.repository"
    "attribute.repository_id"    = "assertion.repository_id"
    "attribute.ref"              = "assertion.ref"
    "attribute.event_name"       = "assertion.event_name"
    "attribute.workflow_ref"     = "assertion.workflow_ref"
    "attribute.job_workflow_ref" = "assertion.job_workflow_ref"
  }

  # Tokens from any other repository, or from any other ref of this repository
  # (pull requests, feature branches, tags), are rejected before any IAM check.
  # Deploying is the only thing CI does in GCP; if you later want e.g. a read-only
  # `terraform plan` on PRs, drop the ref clause here and bind a separate read-only SA.
  attribute_condition = join(" && ", compact([
    "assertion.repository == \"${var.github_repository}\"",
    "assertion.ref == \"${var.deploy_ref}\"",
    var.github_repository_id == "" ? "" : "assertion.repository_id == \"${var.github_repository_id}\"",
  ]))

  oidc {
    issuer_uri = "https://token.actions.githubusercontent.com"
  }
}

# Defense in depth: even within the pool, only the exact subject
# "repo:<owner>/<repo>:ref:<deploy_ref>" may impersonate the deployer.
resource "google_service_account_iam_member" "deployer_wif" {
  service_account_id = google_service_account.deployer.name
  role               = "roles/iam.workloadIdentityUser"
  member             = "principal://iam.googleapis.com/${google_iam_workload_identity_pool.github.name}/subject/repo:${var.github_repository}:ref:${var.deploy_ref}"
}
